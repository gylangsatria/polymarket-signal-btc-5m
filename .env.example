# AI API (9router / coding-fast) — optional
# Kosongkan AI_API_KEY untuk menonaktifkan AI (sinyal aturan saja).
AI_API_KEY=sk-...
AI_BASE_URL=https://ai-gateway.gylang.my.id/v1
AI_MODEL=coding-fast

# --- Auto-trade Polymarket (CLOB) ---
# Auth: SDK menurunkan API creds otomatis dari POLY_PRIVATE_KEY.
# POLY_FUNDER_ADDRESS = alamat Polymarket (proxy wallet) — dana & posisi
# tetap sebagai collateral di Polymarket, tidak pernah di-withdraw.
POLY_PRIVATE_KEY=0x...
# POLY_FUNDER_ADDRESS opsional (legacy). SDK 0.4+ menurunkan Deposit Wallet
# sendiri dari private key — jangan isi address yang bukan milik key itu.

AUTO_TRADE=false          # MODE APLIKASI:
                          #   true  = AUTO-TRADING (prediksi + eksekusi order otomatis)
                          #   false = SIGNAL-ONLY (hanya menampilkan prediksi, tidak trade)
TRADE_AMOUNT_USD=5.0      # nominal per window (USD)
TRADE_ON_URGENT=false     # true = ikut eksekusi sinyal URGENT (delta >= 0.15%)
TRADE_DRY_RUN=true        # true = hanya cetak rencana order tanpa eksekusi
TRADE_MAX_ASK=0.6         # skip order jika best ask > ambang (harga masuk maksimal, jalur normal)
TRADE_HARD_MAX_ASK=0.85   # ceiling mutlak SEMUA mode (agresif tetap kena): bayar <= 85ct; harga >= prob% ditolak guard EV
TRADE_MIN_ASK=0.35        # jangan beli token semurah ini (sisi yang pasar sudah yakin kalah)
TRADE_AGGRESSIVE=false    # true = prediksi prob >= TRADE_MIN_PROB -> langsung beli, lewati TRADE_MAX_ASK
TRADE_MIN_PROB=75          # ambang probabilitas mode agresif, dalam persen (75 = hanya entry yakin)
TRADE_MIN_PROB_ENTRY=50    # lantai keyakinan MUTLAK semua mode: jangan pernah entry jika prob < ini
RECHECK_INTERVAL=5         # detik: seberapa sering bot cek ulang harga & posisi (entry/TP/cut-loss)
SELL_BID_MIN=0.95          # take-profit: jual jika best bid token >= ambang ini
SELL_ROI_MIN=0.10          # take-profit ROI: jual saat (bid - entry)/entry >= ini (default 10%)
SELL_CUT_LOSS=0.25         # cut-loss: jual jika best bid <= ambang ini (jual hanya saat benar-benar mati)
SELL_CUT_LOSS_MIN_ELAPSED=90      # jangan cut-loss di < N detik pertama sejak entry (market masih volatile)
STOP_AFTER_TAKE_PROFIT=true       # true = setelah take-profit berhenti di window itu (tunggu market berikutnya); false = bisa beli lagi (scalping)